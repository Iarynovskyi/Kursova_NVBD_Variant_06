  <Kpis>
    <Kpi>
      <ID>Treatment Effectiveness</ID>
      <Name>Ефективність лікування</Name>
      <Description>Частка завершених випадків з одужанням або покращенням; ціль поліклініки — 70%</Description>
      <DisplayFolder>Клінічні</DisplayFolder>
      <AssociatedMeasureGroupID>Visits</AssociatedMeasureGroupID>
      <Value>[Measures].[Частка одужань]</Value>
      <Goal>0.70</Goal>
      <Status>CASE
        WHEN ISEMPTY(KPIVALUE(&quot;Ефективність лікування&quot;)) THEN NULL
        WHEN KPIVALUE(&quot;Ефективність лікування&quot;) &gt;= KPIGOAL(&quot;Ефективність лікування&quot;) THEN 1
        WHEN KPIVALUE(&quot;Ефективність лікування&quot;) &gt;= KPIGOAL(&quot;Ефективність лікування&quot;) - 0.07 THEN 0
        ELSE -1
        END</Status>
        <Trend>CASE
          WHEN ISEMPTY([Measures].[Частка одужань PY]) THEN 0
          WHEN [Measures].[Частка одужань] &gt; [Measures].[Частка одужань PY] THEN 1
          WHEN [Measures].[Частка одужань] &lt; [Measures].[Частка одужань PY] THEN -1
          ELSE 0
          END</Trend>
          <StatusGraphic>Traffic Light</StatusGraphic>
          <TrendGraphic>Standard Arrow</TrendGraphic>
        </Kpi>
        <Kpi>
          <ID>Consultation Revenue</ID>
          <Name>Дохід від консультацій</Name>
          <Description>Вартість консультацій проти цілі: +5% до попереднього року</Description>
          <DisplayFolder>Фінансові</DisplayFolder>
          <AssociatedMeasureGroupID>Visits</AssociatedMeasureGroupID>
          <Value>[Measures].[Вартість консультацій у грн]</Value>
          <Goal>[Measures].[Вартість консультацій PY у грн] * 1.05</Goal>
          <Status>CASE
            WHEN ISEMPTY(KPIGOAL(&quot;Дохід від консультацій&quot;)) OR KPIGOAL(&quot;Дохід від консультацій&quot;) = 0 THEN NULL
            WHEN KPIVALUE(&quot;Дохід від консультацій&quot;) &gt;= KPIGOAL(&quot;Дохід від консультацій&quot;) THEN 1
            WHEN KPIVALUE(&quot;Дохід від консультацій&quot;) &gt;= KPIGOAL(&quot;Дохід від консультацій&quot;) * 0.95 THEN 0
            ELSE -1
            END</Status>
            <Trend>CASE
              WHEN ISEMPTY([Measures].[Приріст вартості консультацій YoY]) THEN 0
              WHEN [Measures].[Приріст вартості консультацій YoY] &gt; 0 THEN 1
              WHEN [Measures].[Приріст вартості консультацій YoY] &lt; 0 THEN -1
              ELSE 0
              END</Trend>
              <StatusGraphic>Gauge - Ascending</StatusGraphic>
              <TrendGraphic>Standard Arrow</TrendGraphic>
            </Kpi>
          </Kpis>
