  <Source>
    <DataSourceViewID>Polyclinic DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript>
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
            MDX-скрипт куба Polyclinic DW (курсова НВБД, варіант 6 «Поліклініка»).
            CALCULATE агрегує листові комірки куба — не видаляти.
            */
            CALCULATE;
            /* ===== Обчислювані члени вимірів ===== */
            CREATE MEMBER CURRENTCUBE.[Пацієнт].[Рік народження].[Усі].[Пенсійного віку (народжені до 1962 року)]
            AS AGGREGATE(FILTER([Пацієнт].[Рік народження].[Рік народження].MEMBERS, [Пацієнт].[Рік народження].CURRENTMEMBER.MEMBERVALUE &lt;= 1961)),
            VISIBLE = 1;
            CREATE MEMBER CURRENTCUBE.[Вікова група].[Вікова група].[Усі].[Дорослі від 18 років]
            AS AGGREGATE(FILTER([Вікова група].[Вікова група].[Вікова група].MEMBERS, [Вікова група].[Вікова група].CURRENTMEMBER.PROPERTIES(&quot;KEY&quot;, TYPED) &gt;= 2)),
            VISIBLE = 1;
            /* ===== Іменовані набори (Ranking, Top-N) ===== */
            CREATE DYNAMIC SET CURRENTCUBE.[Лікарі за кількістю візитів]
            AS ORDER([Лікар].[Лікар].[Лікар].MEMBERS, [Measures].[Кількість візитів], BDESC);
            CREATE DYNAMIC SET CURRENTCUBE.[Топ-10 лікарів за візитами]
            AS TOPCOUNT([Лікар].[Лікар].[Лікар].MEMBERS, 10, [Measures].[Кількість візитів]);
            CREATE DYNAMIC SET CURRENTCUBE.[Топ-10 хвороб за кількістю випадків]
            AS TOPCOUNT([Хвороба].[Хвороба].[Хвороба].MEMBERS, 10, [Measures].[Кількість діагнозів]);
            CREATE DYNAMIC SET CURRENTCUBE.[Топ-10 препаратів за вартістю]
            AS TOPCOUNT([Лікарський засіб].[Препарат].[Препарат].MEMBERS, 10, [Measures].[Вартість ліків у грн]);
            /* ===== Обчислювані міри: середні, частки, Time Intelligence (YTD, PY, YoY), ковзне середнє, рейтинги, бізнес-метрики ===== */
            CREATE MEMBER CURRENTCUBE.[Measures].[Середня тривалість прийому у хв]
            AS IIF([Measures].[Кількість візитів] = 0, NULL, [Measures].[Тривалість прийомів у хв] / [Measures].[Кількість візитів]),
            FORMAT_STRING = &quot;#,##0.0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Середні значення', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Середня вартість платного прийому у грн]
            AS IIF([Measures].[Кількість візитів] - [Measures].[Безкоштовних візитів НСЗУ] = 0, NULL,
            [Measures].[Вартість консультацій у грн] / ([Measures].[Кількість візитів] - [Measures].[Безкоштовних візитів НСЗУ])),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Середні значення', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Середня тривалість лікування у днях]
            AS IIF([Measures].[Завершених випадків] = 0, NULL, [Measures].[Дні лікування] / [Measures].[Завершених випадків]),
            FORMAT_STRING = &quot;#,##0.0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Середні значення', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Лікарняних на діагноз у днях]
            AS IIF([Measures].[Кількість діагнозів] = 0, NULL, [Measures].[Дні лікарняних] / [Measures].[Кількість діагнозів]),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Середні значення', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка одужань]
            AS IIF([Measures].[Завершених випадків] = 0, NULL, [Measures].[Випадків з одужанням] / [Measures].[Завершених випадків]),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Ефективність лікування', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка безкоштовних візитів НСЗУ]
            AS IIF([Measures].[Кількість візитів] = 0, NULL, [Measures].[Безкоштовних візитів НСЗУ] / [Measures].[Кількість візитів]),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Частки', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка хвороби у візитах]
            AS IIF(([Measures].[Кількість діагнозів], ROOT([Хвороба])) = 0, NULL,
            [Measures].[Кількість діагнозів] / ([Measures].[Кількість діагнозів], ROOT([Хвороба]))),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Частки', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка лікаря у візитах]
            AS IIF(([Measures].[Кількість візитів], ROOT([Лікар])) = 0, NULL,
            [Measures].[Кількість візитів] / ([Measures].[Кількість візитів], ROOT([Лікар]))),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Частки', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Візити з початку року (YTD)]
            AS IIF([Дата].[Календар].CURRENTMEMBER.LEVEL.ORDINAL = 0, NULL,
            AGGREGATE(YTD([Дата].[Календар].CURRENTMEMBER), [Measures].[Кількість візитів])),
            FORMAT_STRING = &quot;#,##0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Візити попереднього року (PY)]
            AS ([Measures].[Кількість візитів], PARALLELPERIOD([Дата].[Календар].[Рік], 1, [Дата].[Календар].CURRENTMEMBER)),
            FORMAT_STRING = &quot;#,##0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Приріст візитів YoY]
            AS IIF(ISEMPTY([Measures].[Візити попереднього року (PY)]) OR [Measures].[Візити попереднього року (PY)] = 0, NULL,
            ([Measures].[Кількість візитів] - [Measures].[Візити попереднього року (PY)]) / [Measures].[Візити попереднього року (PY)]),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Вартість консультацій YTD у грн]
            AS IIF([Дата].[Календар].CURRENTMEMBER.LEVEL.ORDINAL = 0, NULL,
            AGGREGATE(YTD([Дата].[Календар].CURRENTMEMBER), [Measures].[Вартість консультацій у грн])),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Вартість консультацій PY у грн]
            AS ([Measures].[Вартість консультацій у грн], PARALLELPERIOD([Дата].[Календар].[Рік], 1, [Дата].[Календар].CURRENTMEMBER)),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Приріст вартості консультацій YoY]
            AS IIF(ISEMPTY([Measures].[Вартість консультацій PY у грн]) OR [Measures].[Вартість консультацій PY у грн] = 0, NULL,
            ([Measures].[Вартість консультацій у грн] - [Measures].[Вартість консультацій PY у грн]) / [Measures].[Вартість консультацій PY у грн]),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка одужань PY]
            AS ([Measures].[Частка одужань], PARALLELPERIOD([Дата].[Календар].[Рік], 1, [Дата].[Календар].CURRENTMEMBER)),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Ефективність лікування', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Ковзне середнє візитів (3 періоди)]
            AS IIF([Дата].[Календар].CURRENTMEMBER.LEVEL.ORDINAL = 0, NULL,
            AVG(LASTPERIODS(3, [Дата].[Календар].CURRENTMEMBER), [Measures].[Кількість візитів])),
            FORMAT_STRING = &quot;#,##0.0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Аналіз у часі', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Рейтинг лікаря за візитами]
            AS IIF([Лікар].[Лікар].CURRENTMEMBER.LEVEL.ORDINAL = 0 OR ISEMPTY([Measures].[Кількість візитів]), NULL,
            RANK([Лікар].[Лікар].CURRENTMEMBER, [Лікарі за кількістю візитів])),
            FORMAT_STRING = &quot;#,##0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Рейтинги', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Рейтинг хвороби]
            AS IIF([Хвороба].[Хвороба].CURRENTMEMBER.LEVEL.ORDINAL = 0 OR ISEMPTY([Measures].[Кількість діагнозів]), NULL,
            RANK([Хвороба].[Хвороба].CURRENTMEMBER, ORDER([Хвороба].[Хвороба].[Хвороба].MEMBERS, [Measures].[Кількість діагнозів], BDESC))),
            FORMAT_STRING = &quot;#,##0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Рейтинги', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Дохід на годину прийому у грн]
            AS IIF([Measures].[Тривалість прийомів у хв] = 0, NULL,
            [Measures].[Вартість консультацій у грн] / ([Measures].[Тривалість прийомів у хв] / 60)),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Візити';
            CREATE MEMBER CURRENTCUBE.[Measures].[Візитів на робочий день]
            AS IIF([Measures].[Робочих днів] = 0, NULL, [Measures].[Візитів за місяць] / [Measures].[Робочих днів]),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Завантаженість лікарів';
            CREATE MEMBER CURRENTCUBE.[Measures].[Візитів на лікаря за місяць]
            AS IIF([Measures].[Лікаре-місяців] = 0, NULL, [Measures].[Візитів за місяць] / [Measures].[Лікаре-місяців]),
            FORMAT_STRING = &quot;#,##0.0&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Завантаженість лікарів';
            CREATE MEMBER CURRENTCUBE.[Measures].[Частка компенсації ліків]
            AS IIF([Measures].[Вартість ліків у грн] = 0, NULL, [Measures].[Компенсація держави у грн] / [Measures].[Вартість ліків у грн]),
            FORMAT_STRING = &quot;0.0%&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Рецепти';
            CREATE MEMBER CURRENTCUBE.[Measures].[Вартість ліків на пацієнта у грн]
            AS IIF([Measures].[Унікальних пацієнтів] = 0, NULL, [Measures].[Вартість ліків у грн] / [Measures].[Унікальних пацієнтів]),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Рецепти';
            CREATE MEMBER CURRENTCUBE.[Measures].[Рецептів на діагноз]
            AS IIF([Measures].[Кількість діагнозів] = 0, NULL, [Measures].[Кількість рецептів] / [Measures].[Кількість діагнозів]),
            FORMAT_STRING = &quot;#,##0.00&quot;,
            VISIBLE = 1, DISPLAY_FOLDER = 'Бізнес-метрики', ASSOCIATED_MEASURE_GROUP = 'Рецепти';
          </Text>
        </Command>
      </Commands>
