                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="DateKey" msprop:FriendlyName="DateKey" msprop:DbColumnName="DateKey" type="xs:int" />
                  <xs:element name="PatientKey" msprop:FriendlyName="PatientKey" msprop:DbColumnName="PatientKey" type="xs:int" />
                  <xs:element name="DoctorKey" msprop:FriendlyName="DoctorKey" msprop:DbColumnName="DoctorKey" type="xs:int" />
                  <xs:element name="DiseaseKey" msprop:FriendlyName="DiseaseKey" msprop:DbColumnName="DiseaseKey" type="xs:int" />
                  <xs:element name="MedicationKey" msprop:FriendlyName="MedicationKey" msprop:DbColumnName="MedicationKey" type="xs:int" />
                  <xs:element name="AgeGroupKey" msprop:FriendlyName="AgeGroupKey" msprop:DbColumnName="AgeGroupKey" type="xs:int" />
                  <xs:element name="PrescriptionCount" msprop:FriendlyName="PrescriptionCount" msprop:DbColumnName="PrescriptionCount" type="xs:unsignedByte" />
                  <xs:element name="QuantityPackages" msprop:FriendlyName="QuantityPackages" msprop:DbColumnName="QuantityPackages" type="xs:unsignedByte" />
                  <xs:element name="CourseDurationDays" msprop:FriendlyName="CourseDurationDays" msprop:DbColumnName="CourseDurationDays" type="xs:short" />
                  <xs:element name="UnitPriceSnapshot" msprop:FriendlyName="UnitPriceSnapshot" msprop:DbColumnName="UnitPriceSnapshot" type="xs:decimal" />
                  <xs:element name="TotalMedicationCostUAH" msprop:FriendlyName="TotalMedicationCostUAH" msprop:DbColumnName="TotalMedicationCostUAH" type="xs:decimal" />
                  <xs:element name="SubsidizedAmountUAH" msprop:FriendlyName="SubsidizedAmountUAH" msprop:DbColumnName="SubsidizedAmountUAH" type="xs:decimal" />
                  <xs:element name="PatientPaidUAH" msprop:FriendlyName="PatientPaidUAH" msprop:DbColumnName="PatientPaidUAH" type="xs:decimal" />
                  <xs:element name="SubsidizedCount" msdata:ReadOnly="true" msprop:DbColumnName="SubsidizedCount" msprop:ComputedColumnExpression="CAST(IsSubsidized AS INT)" msprop:Description="1 = пільговий рецепт «Доступні ліки»" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="dbo_FactDoctorMonthlySummary" msprop:FriendlyName="FactDoctorMonthlySummary" msprop:DbSchemaName="dbo" msprop:DbTableName="FactDoctorMonthlySummary" msprop:TableType="Table">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="SummaryKey" msprop:FriendlyName="SummaryKey" msprop:DbColumnName="SummaryKey" type="xs:int" />
                  <xs:element name="DoctorKey" msprop:FriendlyName="DoctorKey" msprop:DbColumnName="DoctorKey" type="xs:int" />
                  <xs:element name="MonthKey" msprop:FriendlyName="MonthKey" msprop:DbColumnName="MonthKey" type="xs:int" />
                  <xs:element name="MonthDateKey" msprop:FriendlyName="MonthDateKey" msprop:DbColumnName="MonthDateKey" type="xs:int" />
                  <xs:element name="TotalVisitsCount" msprop:FriendlyName="TotalVisitsCount" msprop:DbColumnName="TotalVisitsCount" type="xs:int" />
                  <xs:element name="UniquePatientsCount" msprop:FriendlyName="UniquePatientsCount" msprop:DbColumnName="UniquePatientsCount" type="xs:int" />
                  <xs:element name="FreeNSZUVisitsCount" msprop:FriendlyName="FreeNSZUVisitsCount" msprop:DbColumnName="FreeNSZUVisitsCount" type="xs:int" />
                  <xs:element name="TotalDurationMinutes" msprop:FriendlyName="TotalDurationMinutes" msprop:DbColumnName="TotalDurationMinutes" type="xs:int" />
                  <xs:element name="AvgVisitDurationMinutes" msprop:FriendlyName="AvgVisitDurationMinutes" msprop:DbColumnName="AvgVisitDurationMinutes" type="xs:decimal" />
                  <xs:element name="MinVisitDurationMinutes" msprop:FriendlyName="MinVisitDurationMinutes" msprop:DbColumnName="MinVisitDurationMinutes" type="xs:short" />
                  <xs:element name="MaxVisitDurationMinutes" msprop:FriendlyName="MaxVisitDurationMinutes" msprop:DbColumnName="MaxVisitDurationMinutes" type="xs:short" />
                  <xs:element name="TotalRevenueUAH" msprop:FriendlyName="TotalRevenueUAH" msprop:DbColumnName="TotalRevenueUAH" type="xs:decimal" />
                  <xs:element name="TotalSickLeaveDaysIssued" msprop:FriendlyName="TotalSickLeaveDaysIssued" msprop:DbColumnName="TotalSickLeaveDaysIssued" type="xs:int" />
                  <xs:element name="WorkingDaysInMonth" msprop:FriendlyName="WorkingDaysInMonth" msprop:DbColumnName="WorkingDaysInMonth" type="xs:unsignedByte" />
                  <xs:element name="VisitsPerWorkingDay" msprop:FriendlyName="VisitsPerWorkingDay" msprop:DbColumnName="VisitsPerWorkingDay" type="xs:decimal" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:choice>
        </xs:complexType>
        <xs:unique name="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimDate" />
          <xs:field xpath="DateKey" />
        </xs:unique>
        <xs:unique name="dbo_DimPatient_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimPatient" />
          <xs:field xpath="PatientKey" />
        </xs:unique>
        <xs:unique name="dbo_DimDoctor_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimDoctor" />
          <xs:field xpath="DoctorKey" />
        </xs:unique>
        <xs:unique name="dbo_DimDisease_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimDisease" />
