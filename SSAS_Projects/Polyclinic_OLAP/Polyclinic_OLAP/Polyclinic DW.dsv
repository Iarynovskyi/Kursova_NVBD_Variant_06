        </xs:unique>
        <xs:unique name="dbo_DimMedication_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimMedication" />
          <xs:field xpath="MedicationKey" />
        </xs:unique>
        <xs:unique name="dbo_DimAgeGroup_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimAgeGroup" />
          <xs:field xpath="AgeGroupKey" />
        </xs:unique>
        <xs:unique name="dbo_DimClinicalOutcome_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_DimClinicalOutcome" />
          <xs:field xpath="OutcomeKey" />
        </xs:unique>
        <xs:unique name="NQ_ICD10Chapters_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//NQ_ICD10Chapters" />
          <xs:field xpath="ChapterLetter" />
        </xs:unique>
        <xs:unique name="NQ_SourceSystem_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//NQ_SourceSystem" />
          <xs:field xpath="SourceSystem" />
        </xs:unique>
        <xs:unique name="dbo_FactVisits_Constraint1" msdata:ConstraintName="Constraint1" msdata:PrimaryKey="true">
          <xs:selector xpath=".//dbo_FactVisits" />
