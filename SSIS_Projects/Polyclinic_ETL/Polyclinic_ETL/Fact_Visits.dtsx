                          length="20"
                          lineageId="Package\SEQ Факт у staging\DFT Факт візитів\SRC OLTP Візити і діагнози.Outputs[OLE DB Source Output].Columns[SourceSystem]"
                          name="SourceSystem"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\SEQ Факт у staging\DFT Факт візитів\SRC OLTP Візити і діагнози.Outputs[OLE DB Source Output].Columns[VisitID_Source]"
                          dataType="i8"
