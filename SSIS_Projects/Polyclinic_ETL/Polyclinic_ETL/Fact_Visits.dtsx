          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Перевірка CSV-файлу архіву Філії №2
/* Script Task пакета Fact_Visits.dtsx (ForEach Loop по файлах архіву).
 * Перевіряє файл перед завантаженням: існування, розмір, заголовок, кількість рядків даних.
 * Вихід: User::CurrentFileName, User::FileRowCount, User::FileSizeBytes, User::FileIsValid.
 * Некоректний файл не зупиняє пакет — генерується попередження (OnWarning) і файл пропускається. */
#endregion

using System;
using System.IO;
using System.Text;
using Microsoft.SqlServer.Dts.Runtime;

namespace ST_8e1d4ade82514f98807a19ae83b5f318
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private const string ExpectedHeader =
            "RecordNo;VisitDateTime;PatientCard;DoctorLicense;ICD10;VisitType;Severity;DurationMin;" +
            "CostAmount;Currency;IsFreeNSZU;Outcome;RecoveryDate;SickLeaveDays;Complaints";

        public void Main()
        {
            string path = Convert.ToString(Dts.Variables["User::CurrentFile"].Value);
            string fileName = Path.GetFileName(path);
            bool isValid = false;
            int rows = 0;
            long size = 0;
            string reason = "";

            try
            {
                FileInfo fi = new FileInfo(path);
                if (!fi.Exists) reason = "файл не знайдено";
                else
                {
                    size = fi.Length;
                    using (StreamReader sr = new StreamReader(path, Encoding.UTF8, true))
                    {
                        string header = sr.ReadLine();
                        if (header == null) reason = "порожній файл";
                        else if (!string.Equals(header.Trim().TrimStart('﻿'), ExpectedHeader, StringComparison.OrdinalIgnoreCase))
                            reason = "неочікуваний заголовок: " + header;
                        else
                        {
                            string line;
                            while ((line = sr.ReadLine()) != null)
                                if (line.Trim().Length > 0) rows++;
                            isValid = rows > 0;
                            if (!isValid) reason = "немає рядків даних";
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                reason = ex.Message;
            }

            Dts.Variables["User::CurrentFileName"].Value = fileName;
            Dts.Variables["User::FileRowCount"].Value = rows;
            Dts.Variables["User::FileSizeBytes"].Value = size;
            Dts.Variables["User::FileIsValid"].Value = isValid;

            bool fireAgain = true;
            if (isValid)
                Dts.Events.FireInformation(0, "Перевірка файлу архіву",
                    string.Format("{0}: {1} рядків даних, {2} байт — файл прийнято", fileName, rows, size), "", 0, ref fireAgain);
            else
                Dts.Events.FireWarning(0, "Перевірка файлу архіву",
                    string.Format("{0}: файл пропущено ({1})", fileName, reason), "", 0);

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}]]></ProjectItem>
