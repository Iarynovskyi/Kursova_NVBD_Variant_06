      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF0D2A11-A476-8F7A-81D2-D230B18B8A71}"
          SQLTask:SqlStatementSource="EXEC etl.usp_StartExecution @PackageName = ?, @LoadType = ?, @ParentExecutionID = ?, @ExecutionID = ? OUTPUT;"
