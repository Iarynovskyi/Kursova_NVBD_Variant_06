                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT d.DoctorID, d.LicenseNumber, d.LastName, d.FirstName, d.MiddleName, dep.DepartmentName, dep.FloorNumber, sp.SpecialtyName,
