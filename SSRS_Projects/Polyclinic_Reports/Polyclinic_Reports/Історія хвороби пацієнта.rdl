                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Sum(Fields!Duration.Value), "0") &amp; " хв · " &amp; Format(Sum(Fields!Cost.Value), "#,##0.00") &amp; " грн"</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
