                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Course.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Color>=IIF(Fields!Course.Value = "Хронічне", "#C55A11", "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style/>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dCourse</rd:DefaultName>
