                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dSeverity">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Severity.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>=IIF(Fields!Severity.Value = "Критична", "Bold", "Normal")</FontWeight>
                                    <Color>=IIF(Fields!Severity.Value = "Тяжка" Or Fields!Severity.Value = "Критична", "#C00000", "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style/>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dSeverity</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dOutcome">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Outcome.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(Fields!Outcome.Value = "Одужання", "#00B050", Fields!Outcome.Value = "Покращення", "#548235", Fields!Outcome.Value = "Ускладнення" Or Fields!Outcome.Value = "Направлено в стаціонар", "#C00000", Fields!Outcome.Value = "В процесі", "#BF8F00", True, "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style/>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dOutcome</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dRecovery">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!RecoveryDate.Value = "01.01.1900", "—", Fields!RecoveryDate.Value)</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dRecovery</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dSick">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!SickDays.Value)</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>#,##0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dSick</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="dRx">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Sum(Fields!RxCount.Value) &gt; 0, "рецептів: " &amp; Sum(Fields!RxCount.Value), "немає")</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Color>=IIF(Sum(Fields!RxCount.Value) &gt; 0, "#0563C1", "#A6A6A6")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style/>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>dRx</rd:DefaultName>
                          <ToggleImage>
                            <InitialState>false</InitialState>
                          </ToggleImage>
                          <ToolTip>=IIF(Sum(Fields!RxCount.Value) &gt; 0, "Розгорнути рецепти (subreport)", "За цим діагнозом рецептів не було")</ToolTip>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.9cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Subreport Name="srPrescriptions">
                          <ReportName>Рецепти діагнозу</ReportName>
                          <Parameters>
                            <Parameter Name="Patient">
                              <Value>=Parameters!Patient.Value</Value>
                            </Parameter>
                            <Parameter Name="VisitDate">
                              <Value>=Fields!VisitDate.UniqueName</Value>
                            </Parameter>
                            <Parameter Name="Disease">
                              <Value>=Fields!Disease.UniqueName</Value>
                            </Parameter>
                            <Parameter Name="ShowHeader">
                              <Value>false</Value>
                            </Parameter>
                          </Parameters>
                          <NoRowsMessage>Рецепти за цим діагнозом не призначались</NoRowsMessage>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                          </Style>
                        </Subreport>
                        <ColSpan>8</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell/>
                    <TablixCell/>
                    <TablixCell/>
                    <TablixCell/>
                    <TablixCell/>
                    <TablixCell/>
                    <TablixCell/>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="txtHistTotal">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
