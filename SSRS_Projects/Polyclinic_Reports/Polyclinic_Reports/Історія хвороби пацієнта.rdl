                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!VisitType.Value &amp; " прийом · " &amp; Fields!Doctor.Value &amp; " (" &amp; Fields!Specialty.Value &amp; ")"</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style/>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>txtVisitDoc</rd:DefaultName>
                          <Style>
