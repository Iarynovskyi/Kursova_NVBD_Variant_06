<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>True</OverwriteDatasets>
    <OverwriteDataSources>True</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Поліклініка/Звіти</TargetReportFolder>
    <TargetDatasetFolder>Поліклініка/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Поліклініка/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Поліклініка/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://desktop-i5cogtd/ReportServer</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Поліклініка/Звіти</TargetReportFolder>
    <TargetDatasetFolder>Поліклініка/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Поліклініка/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Поліклініка/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Поліклініка/Звіти</TargetReportFolder>
    <TargetDatasetFolder>Поліклініка/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Поліклініка/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Поліклініка/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSet Include="DS_Years.rsd"/>
    <DataSet Include="DS_Departments.rsd"/>
    <DataSet Include="DS_Specialties.rsd"/>
    <DataSet Include="DS_Doctors.rsd"/>
    <DataSet Include="DS_ICD10Chapters.rsd"/>
    <DataSet Include="DS_AgeGroups.rsd"/>
    <DataSet Include="DS_PatientSearch.rsd"/>
  </ItemGroup>
  <ItemGroup>
    <DataSource Include="PolyclinicOLAP.rds"/>
  </ItemGroup>
  <ItemGroup>
    <Report Include="Лікарі та їх пацієнти.rdl"/>
    <Report Include="Історія хвороби пацієнта.rdl"/>
    <Report Include="Рецепти діагнозу.rdl"/>
    <Report Include="Завантаженість лікарів по місяцях.rdl"/>
    <Report Include="Аналіз ефективності лікування.rdl"/>
    <Report Include="Статистика захворювань.rdl"/>
    <Report Include="Реєстр пацієнтів.rdl"/>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets"/>
</Project>
