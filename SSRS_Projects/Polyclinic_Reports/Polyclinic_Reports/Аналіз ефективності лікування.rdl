<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PolyclinicOLAP">
      <DataSourceReference>PolyclinicOLAP</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>38bb11d2-dee6-d087-d0ec-a85783311a5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsKPI">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[KPI Значення] AS KPIValue("Ефективність лікування")
MEMBER [Measures].[KPI Ціль] AS KPIGoal("Ефективність лікування")
MEMBER [Measures].[KPI Статус] AS KPIStatus("Ефективність лікування")
MEMBER [Measures].[KPI Тренд] AS KPITrend("Ефективність лікування")
SELECT { [Measures].[KPI Значення], [Measures].[KPI Ціль], [Measures].[KPI Статус], [Measures].[KPI Тренд],
         [Measures].[Частка одужань PY], [Measures].[Кількість діагнозів], [Measures].[Випадків з одужанням],
         [Measures].[Завершених випадків], [Measures].[Середня тривалість лікування у днях], [Measures].[Лікарняних на діагноз у днях] } ON COLUMNS
FROM [Polyclinic DW]
WHERE ( STRTOMEMBER(@Year, CONSTRAINED) )</CommandText>
      </Query>
      <Fields>
        <Field Name="KPI_Value">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Значення]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="KPI_Goal">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Ціль]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="KPI_Status">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Статус]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="KPI_Trend">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Тренд]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RatePY">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань PY]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Recovered">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Випадків з одужанням]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Closed">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Завершених випадків]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AvgTreat">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Середня тривалість лікування у днях]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SickPerDiag">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Лікарняних на діагноз у днях]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsCategory">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів], [Measures].[Випадків з одужанням], [Measures].[Завершених випадків],
         [Measures].[Дні лікування] } ON COLUMNS,
NON EMPTY ( [Хвороба].[Категорія хвороби].[Категорія хвороби].MEMBERS
          * DESCENDANTS(STRTOMEMBER(@Year, CONSTRAINED), [Дата].[Календар].[Місяць]) ) ON ROWS
FROM [Polyclinic DW]</CommandText>
      </Query>
      <Fields>
        <Field Name="Category">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Хвороба].[Категорія хвороби].[Категорія хвороби]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Дата].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Recovered">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Випадків з одужанням]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Closed">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Завершених випадків]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TreatDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Дні лікування]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsMonths">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Частка одужань], [Measures].[Частка одужань PY], [Measures].[Кількість діагнозів] } ON COLUMNS,
DESCENDANTS(STRTOMEMBER(@Year, CONSTRAINED), [Дата].[Календар].[Місяць]) ON ROWS
FROM [Polyclinic DW]</CommandText>
      </Query>
      <Fields>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Дата].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Rate">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="RatePY">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань PY]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDeptKPI">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[KPI Статус] AS KPIStatus("Ефективність лікування")
MEMBER [Measures].[KPI Тренд] AS KPITrend("Ефективність лікування")
SELECT { [Measures].[Кількість діагнозів], [Measures].[Частка одужань], [Measures].[Частка одужань PY],
         [Measures].[KPI Статус], [Measures].[KPI Тренд] } ON COLUMNS,
NON EMPTY [Лікар].[Відділення].[Відділення].MEMBERS ON ROWS
FROM [Polyclinic DW]
WHERE ( STRTOMEMBER(@Year, CONSTRAINED) )</CommandText>
      </Query>
      <Fields>
        <Field Name="Department">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Лікар].[Відділення].[Відділення]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Rate">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="RatePY">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань PY]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="KPI_Status">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Статус]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="KPI_Trend">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[KPI Тренд]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSeverity">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів], [Measures].[Частка одужань] } ON COLUMNS,
NON EMPTY [Клінічний результат].[Тяжкість].[Тяжкість].MEMBERS ON ROWS
FROM [Polyclinic DW]
WHERE ( STRTOMEMBER(@Year, CONSTRAINED) )</CommandText>
      </Query>
      <Fields>
        <Field Name="Severity">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Клінічний результат].[Тяжкість].[Тяжкість]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Rate">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка одужань]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsYears">
      <SharedDataSet>
        <SharedDataSetReference>DS_Years</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="ParamValue">
          <DataField>ParamValue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ParamCaption">
          <DataField>ParamCaption</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
