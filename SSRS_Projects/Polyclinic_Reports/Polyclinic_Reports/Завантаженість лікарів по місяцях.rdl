                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!Visits.Value)</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Format>#,##0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>vDoc</rd:DefaultName>
                          <ToolTip>="Візитів на робочий день: " &amp; Format((Sum(Fields!Visits.Value) / IIF(Sum(Fields!WorkingDays.Value) = 0, 1, Sum(Fields!WorkingDays.Value))), "0.00") &amp; " (середнє по вибірці " &amp; Format((Sum(Fields!Visits.Value, "dsWorkload") / IIF(Sum(Fields!WorkingDays.Value, "dsWorkload") = 0, 1, Sum(Fields!WorkingDays.Value, "dsWorkload"))), "0.00") &amp; ")"</ToolTip>
                          <Style>
                            <Border>
                              <Color>#BFBFBF</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>=IIF((Sum(Fields!Visits.Value) / IIF(Sum(Fields!WorkingDays.Value) = 0, 1, Sum(Fields!WorkingDays.Value))) &lt; 0.6 * (Sum(Fields!Visits.Value, "dsWorkload") / IIF(Sum(Fields!WorkingDays.Value, "dsWorkload") = 0, 1, Sum(Fields!WorkingDays.Value, "dsWorkload"))), "#F8CBAD", IIF((Sum(Fields!Visits.Value) / IIF(Sum(Fields!WorkingDays.Value) = 0, 1, Sum(Fields!WorkingDays.Value))) &gt; 1.4 * (Sum(Fields!Visits.Value, "dsWorkload") / IIF(Sum(Fields!WorkingDays.Value, "dsWorkload") = 0, 1, Sum(Fields!WorkingDays.Value, "dsWorkload"))), "#C6EFCE", "White"))</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
