  <Code>' Вбудований код звітів поліклініки (Етап 5)
' Перетворення дати параметра на унікальне ім'я члена куба [Дата].[Календар].[День]
Public Function DayMember(ByVal d As Date) As String
    Return "[Дата].[Календар].[День].&amp;[" &amp; d.ToString("yyyyMMdd") &amp; "]"
End Function
' Валідація діапазону дат (п. 5.3 методички): початок не пізніше кінця, межі сховища 2016-2026
Public Function CheckRange(ByVal f As Date, ByVal t As Date) As String
    If f &gt; t Then
        Throw New System.ArgumentException("Дата початку періоду (" &amp; f.ToString("dd.MM.yyyy") &amp; ") пізніша за дату кінця (" &amp; t.ToString("dd.MM.yyyy") &amp; "). Виправте діапазон дат.")
    End If
    If f &lt; New Date(2016, 1, 1) OrElse t &gt; New Date(2026, 12, 31) Then
        Throw New System.ArgumentException("Діапазон дат має бути в межах 01.01.2016 - 31.12.2026 (період даних сховища).")
    End If
    Return ""
End Function
' Стан KPI «Ефективність лікування» так само, як у кубі: ціль 70 %, жовта зона 63-70 %
Public Function RecoveryStatus(ByVal rate As Object) As Integer
    If rate Is Nothing OrElse IsDBNull(rate) Then Return 0
    Dim r As Double = CDbl(rate)
    If r &gt;= 0.7 Then Return 1
    If r &gt;= 0.63 Then Return 0
    Return -1
End Function
Public Function StatusColor(ByVal s As Integer) As String
    If s = 1 Then Return "#00B050"
    If s = 0 Then Return "#BF8F00"
    Return "#C00000"
End Function
</Code>
