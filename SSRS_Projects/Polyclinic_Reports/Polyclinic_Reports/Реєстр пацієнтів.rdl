<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PolyclinicOLAP">
      <DataSourceReference>PolyclinicOLAP</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>38bb11d2-dee6-d087-d0ec-a85783311a5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsRegistry">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DateFrom">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateFrom.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="AgeGroups">
            <Value>=Parameters!AgeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Search">
            <Value>=Parameters!Search.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[Медична картка] AS [Пацієнт].[Пацієнт].CURRENTMEMBER.PROPERTIES("Медична картка")
MEMBER [Measures].[Останній візит] AS TAIL(NONEMPTY([Дата].[Дата].[Дата].MEMBERS, [Measures].[Кількість візитів]), 1).ITEM(0).MEMBER_KEY
SET [Пацієнти] AS FILTER(NONEMPTY([Пацієнт].[Пацієнт].[Пацієнт].MEMBERS, [Measures].[Кількість візитів]),
    @Search = "" OR INSTR(1, UCASE([Пацієнт].[Пацієнт].CURRENTMEMBER.MEMBER_CAPTION), UCASE(@Search)) &gt; 0)
SELECT { [Measures].[Медична картка], [Measures].[Кількість візитів], [Measures].[Кількість діагнозів],
         [Measures].[Вартість консультацій у грн], [Measures].[Дні лікарняних], [Measures].[Останній візит] } ON COLUMNS,
NON EMPTY ( [Пацієнти] * [Пацієнт].[Стать].[Стать].MEMBERS * [Пацієнт].[Рік народження].[Рік народження].MEMBERS )
  DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_UNIQUE_NAME ON ROWS
FROM ( SELECT ( { STRTOMEMBER(@DateFrom, CONSTRAINED) : STRTOMEMBER(@DateTo, CONSTRAINED) }, STRTOSET(@AgeGroups, CONSTRAINED) ) ON COLUMNS FROM [Polyclinic DW] )</CommandText>
      </Query>
      <Fields>
        <Field Name="Patient">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Пацієнт].[Пацієнт].[Пацієнт]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Gender">
