  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="txtRegNote">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Пацієнти, що мали візити у вибраний період. Клік на ПІБ відкриває «Історію хвороби пацієнта» (drillthrough); сортування — клік на заголовках; пошук за частиною ПІБ або номером картки. Червоним — лікарняний від 14 днів.</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7.5pt</FontSize>
                      <FontStyle>Italic</FontStyle>
                      <Color>#595959</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>txtRegNote</rd:DefaultName>
            <Style>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>1pt</PaddingTop>
              <PaddingBottom>1pt</PaddingBottom>
            </Style>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>0.8cm</Height>
            <Width>25.3cm</Width>
            <ZIndex>0</ZIndex>
          </Textbox>
