                  <TextRun>
                    <Value>="Рецепти діагнозу: " &amp; First(Fields!cPatient.Value, "dsCtx") &amp; "  ·  візит " &amp; First(Fields!cDate.Value, "dsCtx") &amp; "  ·  " &amp; First(Fields!cDisease.Value, "dsCtx")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>9pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1F4E79</Color>
