<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PolyclinicOLAP">
      <DataSourceReference>PolyclinicOLAP</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>38bb11d2-dee6-d087-d0ec-a85783311a5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsRx">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Patient">
            <Value>=Parameters!Patient.Value</Value>
          </QueryParameter>
          <QueryParameter Name="VisitDate">
            <Value>=Parameters!VisitDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Disease">
            <Value>=Parameters!Disease.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість рецептів], [Measures].[Упаковок], [Measures].[Днів курсу лікування], [Measures].[Вартість ліків у грн],
         [Measures].[Компенсація держави у грн], [Measures].[Доплата пацієнтів у грн] } ON COLUMNS,
NON EMPTY ( [Лікарський засіб].[Препарат].[Препарат].MEMBERS * [Лікарський засіб].[Діюча речовина].[Діюча речовина].MEMBERS ) ON ROWS
FROM [Polyclinic DW]
WHERE ( STRTOMEMBER(@Patient, CONSTRAINED), STRTOMEMBER(@VisitDate, CONSTRAINED), STRTOMEMBER(@Disease, CONSTRAINED) )</CommandText>
      </Query>
      <Fields>
        <Field Name="Medication">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Лікарський засіб].[Препарат].[Препарат]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Substance">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Лікарський засіб].[Діюча речовина].[Діюча речовина]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RxCount">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість рецептів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Packages">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Упаковок]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CourseDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Днів курсу лікування]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MedCost">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Вартість ліків у грн]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Subsidy">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Компенсація держави у грн]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PatientPaid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Доплата пацієнтів у грн]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsCtx">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Patient">
            <Value>=Parameters!Patient.Value</Value>
          </QueryParameter>
          <QueryParameter Name="VisitDate">
            <Value>=Parameters!VisitDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Disease">
            <Value>=Parameters!Disease.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[cPatient] AS STRTOMEMBER(@Patient, CONSTRAINED).MEMBER_CAPTION
MEMBER [Measures].[cDate] AS STRTOMEMBER(@VisitDate, CONSTRAINED).MEMBER_CAPTION
MEMBER [Measures].[cDisease] AS STRTOMEMBER(@Disease, CONSTRAINED).MEMBER_CAPTION
SELECT { [Measures].[cPatient], [Measures].[cDate], [Measures].[cDisease] } ON COLUMNS
FROM [Polyclinic DW]</CommandText>
      </Query>
      <Fields>
        <Field Name="cPatient">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[cPatient]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cDate">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[cDate]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cDisease">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[cDisease]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
