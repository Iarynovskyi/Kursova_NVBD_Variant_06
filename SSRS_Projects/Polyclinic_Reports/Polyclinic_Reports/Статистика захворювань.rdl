<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="PolyclinicOLAP">
      <DataSourceReference>PolyclinicOLAP</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>38bb11d2-dee6-d087-d0ec-a85783311a5e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsChapters">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DateFrom">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateFrom.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="Chapters">
            <Value>=Parameters!Chapters.Value</Value>
          </QueryParameter>
          <QueryParameter Name="SourceSet">
            <Value>=IIF(Parameters!IncludeArchive.Value, "{[Джерело даних].[Джерело даних].[Усі]}", "{[Джерело даних].[Джерело даних].&amp;[OLTP]}")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів], [Measures].[Кількість візитів] } ON COLUMNS,
NON EMPTY [Хвороба].[Розділ МКХ-10].[Розділ МКХ-10].MEMBERS ON ROWS
FROM ( SELECT ( { STRTOMEMBER(@DateFrom, CONSTRAINED) : STRTOMEMBER(@DateTo, CONSTRAINED) }, STRTOSET(@Chapters, CONSTRAINED), STRTOSET(@SourceSet, CONSTRAINED) ) ON COLUMNS
       FROM [Polyclinic DW] )</CommandText>
      </Query>
      <Fields>
        <Field Name="Chapter">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Хвороба].[Розділ МКХ-10].[Розділ МКХ-10]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Visits">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість візитів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsMonths">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DateFrom">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateFrom.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="Chapters">
            <Value>=Parameters!Chapters.Value</Value>
          </QueryParameter>
          <QueryParameter Name="SourceSet">
            <Value>=IIF(Parameters!IncludeArchive.Value, "{[Джерело даних].[Джерело даних].[Усі]}", "{[Джерело даних].[Джерело даних].&amp;[OLTP]}")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів] } ON COLUMNS,
NON EMPTY [Дата].[Календар].[Місяць].MEMBERS ON ROWS
FROM ( SELECT ( { STRTOMEMBER(@DateFrom, CONSTRAINED) : STRTOMEMBER(@DateTo, CONSTRAINED) }, STRTOSET(@Chapters, CONSTRAINED), STRTOSET(@SourceSet, CONSTRAINED) ) ON COLUMNS
       FROM [Polyclinic DW] )</CommandText>
      </Query>
      <Fields>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Дата].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsAge">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DateFrom">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateFrom.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="Chapters">
            <Value>=Parameters!Chapters.Value</Value>
          </QueryParameter>
          <QueryParameter Name="SourceSet">
            <Value>=IIF(Parameters!IncludeArchive.Value, "{[Джерело даних].[Джерело даних].[Усі]}", "{[Джерело даних].[Джерело даних].&amp;[OLTP]}")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів] } ON COLUMNS,
NON EMPTY [Вікова група].[Вікова група].[Вікова група].MEMBERS ON ROWS
FROM ( SELECT ( { STRTOMEMBER(@DateFrom, CONSTRAINED) : STRTOMEMBER(@DateTo, CONSTRAINED) }, STRTOSET(@Chapters, CONSTRAINED), STRTOSET(@SourceSet, CONSTRAINED) ) ON COLUMNS
       FROM [Polyclinic DW] )</CommandText>
      </Query>
      <Fields>
        <Field Name="AgeGroup">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Вікова група].[Вікова група].[Вікова група]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsTop10">
      <Query>
        <DataSourceName>PolyclinicOLAP</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="DateFrom">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateFrom.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.CheckRange(Parameters!DateFrom.Value, Parameters!DateTo.Value) &amp; Code.DayMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="Chapters">
            <Value>=Parameters!Chapters.Value</Value>
          </QueryParameter>
          <QueryParameter Name="SourceSet">
            <Value>=IIF(Parameters!IncludeArchive.Value, "{[Джерело даних].[Джерело даних].[Усі]}", "{[Джерело даних].[Джерело даних].&amp;[OLTP]}")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT { [Measures].[Кількість діагнозів], [Measures].[Частка хвороби у візитах], [Measures].[Лікарняних на діагноз у днях] } ON COLUMNS,
TOPCOUNT( [Хвороба].[Хвороба].[Хвороба].MEMBERS * [Хвороба].[Перебіг].[Перебіг].MEMBERS, 10, [Measures].[Кількість діагнозів] ) ON ROWS
FROM ( SELECT ( { STRTOMEMBER(@DateFrom, CONSTRAINED) : STRTOMEMBER(@DateTo, CONSTRAINED) }, STRTOSET(@Chapters, CONSTRAINED), STRTOSET(@SourceSet, CONSTRAINED) ) ON COLUMNS
       FROM [Polyclinic DW] )</CommandText>
      </Query>
      <Fields>
        <Field Name="Disease">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Хвороба].[Хвороба].[Хвороба]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Course">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Хвороба].[Перебіг].[Перебіг]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Diagnoses">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість діагнозів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Share">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Частка хвороби у візитах]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="SickPerDiag">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Лікарняних на діагноз у днях]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsChapterList">
      <SharedDataSet>
        <SharedDataSetReference>DS_ICD10Chapters</SharedDataSetReference>
